<label class="flex items-start gap-3 font-semibold text-[#302b27]" for="{{ id | escape }}">
  <input
    id="{{ id | escape }}"
    name="{{ name | escape }}"
    type="checkbox"
    value="{{ value | escape }}"
    class="mt-0.5 size-5 shrink-0 rounded border-[#302b27]/25 accent-[#bd4828] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#bd4828]"
    {% if checked %}checked{% endif %}
  >
  <span>{% yield %}</span>
</label>
