<div class="grid max-w-4xl gap-5 md:grid-cols-3" data-frame="Card variants">
  {% component "card", label: "Paper card", variant: "paper" %}
    <h2 class="text-xl font-bold">Morning bake</h2>
    <p class="mt-2 text-[#74685e]">Fresh from the oven.</p>
  {% endcomponent %}
  {% component "card", label: "Tinted card", variant: "tinted" %}
    <h2 class="text-xl font-bold">Seasonal pick</h2>
    <p class="mt-2 text-[#74685e]">Made with orchard fruit.</p>
  {% endcomponent %}
  {% component "card", label: "Outlined card", variant: "outlined" %}
    <h2 class="text-xl font-bold">Bakery note</h2>
    <p class="mt-2 text-[#74685e]">Small batches every morning.</p>
  {% endcomponent %}
</div>
