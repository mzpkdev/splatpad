<select
  id="{{ id | escape }}"
  name="{{ name | escape }}"
  class="w-full rounded-2xl border border-[#302b27]/20 bg-white px-4 py-3 text-[#302b27] outline-none focus:border-[#bd4828] focus:ring-2 focus:ring-[#bd4828]/20"
  {% if required %}required{% endif %}
  {% if described_by %}aria-describedby="{{ described_by | escape }}"{% endif %}
>
  {% yield %}
</select>
