<article class="rounded-[2rem] bg-[#fffaf1] p-6 shadow-[0_12px_30px_rgba(48,43,39,0.06)]">
  <div class="mb-5 grid aspect-[5/3] place-items-center rounded-2xl bg-[{{ item.color }}] text-6xl" aria-hidden="true">{{ item.mark }}</div>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-lg font-bold">{{ item.name }}</h3>
      <p class="mt-1 text-sm leading-6 text-[#74685e]">{{ item.description }}</p>
    </div>
    <p class="font-bold text-[#b14f31]">{{ item.price }}</p>
  </div>
</article>
