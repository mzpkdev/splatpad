{% layout 'base' %}

{% block content %}
  <main>
    <section class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1.1fr_0.9fr]" data-frame="Home hero">
      <div data-frame="Hero introduction">
      <p class="mb-5 text-sm font-bold uppercase tracking-[0.18em] text-[#b14f31]">
        {{ page.eyebrow }}
      </p>
      <h1 class="max-w-3xl text-5xl font-bold leading-[0.95] tracking-[-0.04em] sm:text-7xl">
        {{ page.title }}
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-8 text-[#62584f]">
        {{ page.description }}
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        {% component "link-button", href: page.cta.href, variant: "primary" %}
          {{ page.cta.label }}
        {% endcomponent %}
        {% component "link-button", href: "/visit/", variant: "secondary" %}Plan a visit{% endcomponent %}
      </div>
      </div>
      <div class="relative mx-auto aspect-square w-full max-w-md rounded-[3rem] bg-[#dbe5cb] p-8 sm:p-12" role="img" aria-label="A fresh loaf of bread with a baked-this-morning label" data-frame="Fresh loaf illustration">
        <div class="absolute left-8 top-9 size-16 rounded-full bg-[#f4c95d]"></div>
        <div class="grid h-full place-items-center rounded-[45%_55%_48%_52%] bg-[#e9a55f] text-8xl shadow-[inset_-18px_-20px_0_rgba(177,79,49,0.12)]" aria-hidden="true">☁</div>
        <div class="absolute bottom-9 right-7 rotate-6 shadow-sm">
          {% component "badge", variant: "accent" %}Baked this morning{% endcomponent %}
        </div>
      </div>
    </section>

    <section class="bg-[#f4e6d2]" data-frame="Featured menu">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
        <div class="mb-9 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#b14f31]">On the counter</p>
            <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">A few neighborhood favorites</h2>
          </div>
          <a class="font-bold underline decoration-[#bd4828] decoration-2 underline-offset-4" href="/menu/">See the full menu</a>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
        {% for item in featured_items %}
          {% component "menu-card", name: item.name, mark: item.mark, color: item.color %}
            {{ item.description }}
            {% slot "price" %}{{ item.price }}{% endslot %}
          {% endcomponent %}
        {% endfor %}
        </div>
      </div>
    </section>
  </main>
{% endblock %}
