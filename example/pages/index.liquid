{% layout 'base' %}

{% block content %}
  <main>
    <section class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-cyan-400">
        {{ page.eyebrow }}
      </p>
      <h1 class="max-w-4xl text-4xl font-bold tracking-tight sm:text-6xl">
        {{ page.title }}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-400">
        {{ page.description }}
      </p>

      {% if page.cta %}
        <a
          class="mt-8 inline-flex rounded-md bg-cyan-400 px-5 py-3 font-semibold text-zinc-950 hover:bg-cyan-300"
          href="{{ page.cta.href }}"
        >
          {{ page.cta.label }}
        </a>
      {% endif %}
    </section>

    <section class="border-t border-zinc-800 bg-zinc-900/50">
      <div class="mx-auto grid max-w-6xl gap-6 px-6 py-20 md:grid-cols-3">
        {% for feature in features %}
          {% render 'feature-card', feature: feature %}
        {% else %}
          <p class="text-zinc-400">No features configured.</p>
        {% endfor %}
      </div>
    </section>
  </main>
{% endblock %}
