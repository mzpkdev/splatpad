{% layout 'base' %}

{% block content %}
  <main class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div data-frame="Visit details">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#b14f31]">Visit us</p>
        <h1 class="mt-3 text-5xl font-bold leading-[0.98] tracking-[-0.04em] sm:text-7xl">{{ page.title }}</h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-[#62584f]">{{ page.description }}</p>
        <dl class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
          <div>
            <dt class="text-sm font-bold uppercase tracking-wider text-[#b14f31]">Find us</dt>
            <dd class="mt-2 text-lg font-semibold">{{ site.address }}</dd>
          </div>
          <div>
            <dt class="text-sm font-bold uppercase tracking-wider text-[#b14f31]">Hours</dt>
            <dd class="mt-2 whitespace-pre-line text-lg font-semibold">{{ site.hours }}</dd>
          </div>
        </dl>
      </div>
      <section class="relative min-h-96 overflow-hidden rounded-[3rem] bg-[#dbe5cb] p-8 sm:p-12" aria-label="Map to the bakery" data-frame="Bakery map">
        <div class="absolute -left-10 top-20 h-10 w-[120%] -rotate-12 bg-white/65"></div>
        <div class="absolute left-1/3 -top-10 h-[120%] w-10 rotate-12 bg-white/65"></div>
        <div class="absolute bottom-16 left-14 h-8 w-[80%] rotate-6 bg-white/65"></div>
        <div class="relative z-10 grid h-full place-items-center">
          <div class="rounded-[2rem] bg-[#bd4828] p-7 text-center text-white shadow-xl">
            <p class="text-4xl" aria-hidden="true">✿</p>
            <h2 class="mt-2 text-xl font-bold">Crumb & Bloom</h2>
            <p class="mt-1 text-sm text-white">Right by Alder Park</p>
          </div>
        </div>
      </section>
    </div>

    <section class="mt-16 border-t border-[#302b27]/10 pt-16" aria-labelledby="visit-plan-title" data-frame="Visit planner">
      <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#b14f31]">Before you stop by</p>
          <h2 id="visit-plan-title" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Plan a bakery visit</h2>
          <p class="mt-4 max-w-md leading-7 text-[#62584f]">
            Tell us when you hope to come and what would make the visit easier. This planner keeps the details together on the page.
          </p>
        </div>

        <form class="grid gap-6 rounded-[2rem] bg-[#f4e6d2] p-6 sm:grid-cols-2 sm:p-8" action="/visit/" method="get">
          {% component "field", id: "visit-name", label: "Your name" %}
            {% component "input", id: "visit-name", name: "name", type: "text", placeholder: "Ada", value: "", autocomplete: "name", required: true, described_by: "visit-name-description" %}{% endcomponent %}
            {% slot "description" %}Who should we expect at the bakery?{% endslot %}
          {% endcomponent %}

          {% component "field", id: "visit-email", label: "Email address" %}
            {% component "input", id: "visit-email", name: "email", type: "email", placeholder: "ada@example.com", value: "", autocomplete: "email", required: false, described_by: "visit-email-description" %}{% endcomponent %}
            {% slot "description" %}Optional, in case you want a copy of your plan.{% endslot %}
          {% endcomponent %}

          {% component "field", id: "visit-day", label: "Best day to visit" %}
            {% component "select", id: "visit-day", name: "day", required: true, described_by: "visit-day-description" %}
              <option value="">Choose a day</option>
              <option value="tuesday">Tuesday</option>
              <option value="wednesday">Wednesday</option>
              <option value="thursday">Thursday</option>
              <option value="friday">Friday</option>
              <option value="saturday">Saturday</option>
              <option value="sunday">Sunday</option>
            {% endcomponent %}
            {% slot "description" %}We are open Tuesday through Sunday.{% endslot %}
          {% endcomponent %}

          <div class="sm:col-span-2">
            {% component "field", id: "visit-note", label: "Anything we should know?" %}
              {% component "textarea", id: "visit-note", name: "note", placeholder: "A favorite loaf, a larger group, or an accessibility request", rows: 4, value: "", required: false, described_by: "visit-note-description" %}{% endcomponent %}
              {% slot "description" %}Optional. Add any detail that will help you plan the stop.{% endslot %}
            {% endcomponent %}
          </div>

          <div class="sm:col-span-2">
            {% component "checkbox", id: "visit-step-free", name: "step_free", value: "yes", checked: false %}
              Include step-free entrance directions in my plan
            {% endcomponent %}
          </div>

          <div class="sm:col-span-2">
            {% component "button", type: "submit", variant: "primary" %}Build my visit plan{% endcomponent %}
          </div>
        </form>
      </div>
    </section>
  </main>
{% endblock %}
