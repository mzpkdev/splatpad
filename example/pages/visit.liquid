{% layout 'base' %}

{% block content %}
  <main class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#b14f31]">Visit us</p>
        <h1 class="mt-3 text-5xl font-bold leading-[0.98] tracking-[-0.04em] sm:text-7xl">{{ page.title }}</h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-[#62584f]">{{ page.description }}</p>
        <dl class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
          <div>
            <dt class="text-sm font-bold uppercase tracking-wider text-[#b14f31]">Find us</dt>
            <dd class="mt-2 text-lg font-semibold">{{ site.address }}</dd>
          </div>
          <div>
            <dt class="text-sm font-bold uppercase tracking-wider text-[#b14f31]">Hours</dt>
            <dd class="mt-2 whitespace-pre-line text-lg font-semibold">{{ site.hours }}</dd>
          </div>
        </dl>
      </div>
      <section class="relative min-h-96 overflow-hidden rounded-[3rem] bg-[#dbe5cb] p-8 sm:p-12" aria-label="Map to the bakery">
        <div class="absolute -left-10 top-20 h-10 w-[120%] -rotate-12 bg-white/65"></div>
        <div class="absolute left-1/3 -top-10 h-[120%] w-10 rotate-12 bg-white/65"></div>
        <div class="absolute bottom-16 left-14 h-8 w-[80%] rotate-6 bg-white/65"></div>
        <div class="relative z-10 grid h-full place-items-center">
          <div class="rounded-[2rem] bg-[#bd4828] p-7 text-center text-white shadow-xl">
            <p class="text-4xl" aria-hidden="true">✿</p>
            <h2 class="mt-2 text-xl font-bold">Crumb & Bloom</h2>
            <p class="mt-1 text-sm text-white">Right by Alder Park</p>
          </div>
        </div>
      </section>
    </div>
  </main>
{% endblock %}
