{% layout 'base' %}

{% block content %}
  <main class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <header data-frame="Menu introduction">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#b14f31]">Made in small batches</p>
      <h1 class="mt-3 text-5xl font-bold tracking-[-0.04em] sm:text-7xl">{{ page.title }}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-[#62584f]">{{ page.description }}</p>
    </header>

    <div class="mt-14 grid gap-x-12 gap-y-14 md:grid-cols-2">
      {% for section in menu %}
        <section aria-labelledby="menu-{{ forloop.index }}" data-frame="Menu section: {{ section.name | escape }}">
          <div class="mb-4 flex items-center gap-3">
            <span class="size-3 rounded-full bg-[#bd4828]"></span>
            <h2 id="menu-{{ forloop.index }}" class="text-2xl font-bold">{{ section.name }}</h2>
          </div>
          <div class="divide-y divide-[#302b27]/10 border-y border-[#302b27]/10">
            {% for item in section.items %}
              <article class="grid grid-cols-[1fr_auto] gap-5 py-5" data-frame="Menu item: {{ item.name | escape }}">
                <div>
                  <h3 class="font-bold">{{ item.name }}</h3>
                  <p class="mt-1 text-sm leading-6 text-[#74685e]">{{ item.description }}</p>
                </div>
                <p class="font-bold text-[#b14f31]">{{ item.price }}</p>
              </article>
            {% endfor %}
          </div>
        </section>
      {% endfor %}
    </div>
    <div class="mt-14" data-frame="Seasonal menu note">
      {% component "alert", label: "Seasonal menu note", variant: "info" %}
        Our case changes with the season. Ask us what just came out of the oven.
      {% endcomponent %}
    </div>
  </main>
{% endblock %}
