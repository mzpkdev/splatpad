{% layout 'base' %}

{% block content %}
  <main>
    <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24" data-frame="Journal introduction">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#b14f31]">Bakehouse journal</p>
      <h1 class="mt-3 max-w-4xl text-5xl font-bold leading-[0.98] tracking-[-0.04em] sm:text-7xl">{{ page.title }}</h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-[#62584f]">{{ page.description }}</p>
    </section>

    <section class="border-t border-[#302b27]/10">
      <div class="mx-auto grid max-w-6xl gap-5 px-5 py-16 sm:px-8 md:grid-cols-2">
        {% for entry in journal_entries %}
          <article class="flex min-h-72 flex-col rounded-[2rem] bg-[#f4e6d2] p-7 sm:p-9" data-frame="Journal entry: {{ entry.title | escape }}">
            <span class="text-5xl" aria-hidden="true">{{ entry.mark }}</span>
            <p class="mt-8 text-sm font-bold uppercase tracking-[0.16em] text-[#74685e]">{{ entry.read_time }}</p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight">{{ entry.title }}</h2>
            <p class="mt-4 leading-7 text-[#62584f]">{{ entry.excerpt }}</p>
            <a class="mt-auto pt-8 font-bold underline decoration-[#bd4828] decoration-2 underline-offset-4" href="{{ entry.href }}">Read the note</a>
          </article>
        {% endfor %}
      </div>
    </section>
  </main>
{% endblock %}
