{% layout 'base' %}

{% block content %}
  <main>
    <section class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#b14f31]">Celebration cakes</p>
        <h1 class="mt-3 text-5xl font-bold leading-[0.98] tracking-[-0.04em] sm:text-7xl">{{ page.title }}</h1>
        <p class="mt-7 max-w-xl text-lg leading-8 text-[#62584f]">{{ page.description }}</p>
        <a class="mt-9 inline-flex rounded-full bg-[#bd4828] px-6 py-3 font-bold text-white" href="/order/cake/">Build your cake →</a>
      </div>
      <div class="grid min-h-96 place-items-center rounded-[3rem] bg-[#f2c8bd] p-8">
        <div class="relative grid aspect-square w-full max-w-sm place-items-center rounded-full bg-[#f4c95d] shadow-[inset_0_-24px_0_rgba(177,79,49,0.12)]">
          <span class="text-8xl" aria-hidden="true">✿</span>
          <span class="absolute -right-3 top-10 rotate-6 rounded-full bg-white px-4 py-2 text-sm font-bold shadow-sm">Made for your day</span>
        </div>
      </div>
    </section>
    <section class="bg-[#302b27] text-white">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:grid-cols-3 sm:px-8">
        <p class="font-bold">Five easy steps</p>
        <p class="font-bold">Serves 8 to 32</p>
        <p class="font-bold">Three days’ notice</p>
      </div>
    </section>
  </main>
{% endblock %}
