{% layout 'base' %}

{% block content %}
  <main class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
    {% render 'order-progress', order_steps: order_steps, page: page %}
    <section class="mt-12">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#b14f31]">Step 2 of 5 · Flavor</p>
      <h1 class="mt-3 text-5xl font-bold tracking-[-0.04em] sm:text-6xl">{{ page.title }}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-[#62584f]">{{ page.description }}</p>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <a class="flex items-center gap-5 rounded-[2rem] border-2 border-[#bd4828] bg-[#fffaf1] p-6" href="/order/cake/finish/">
          <span class="grid size-20 shrink-0 place-items-center rounded-full bg-[#f4c95d] text-4xl" aria-hidden="true">☼</span><span><strong class="text-xl">Vanilla & strawberry</strong><span class="mt-2 block leading-6 text-[#62584f]">Vanilla bean cake with bright seasonal jam.</span></span>
        </a>
        <a class="flex items-center gap-5 rounded-[2rem] bg-[#f4e6d2] p-6" href="/order/cake/finish/">
          <span class="grid size-20 shrink-0 place-items-center rounded-full bg-[#7c513f] text-4xl text-white" aria-hidden="true">◆</span><span><strong class="text-xl">Chocolate & malt</strong><span class="mt-2 block leading-6 text-[#62584f]">Deep cocoa cake with whipped malted cream.</span></span>
        </a>
        <a class="flex items-center gap-5 rounded-[2rem] bg-[#dbe5cb] p-6" href="/order/cake/finish/">
          <span class="grid size-20 shrink-0 place-items-center rounded-full bg-[#d3b84e] text-4xl" aria-hidden="true">✿</span><span><strong class="text-xl">Lemon & elderflower</strong><span class="mt-2 block leading-6 text-[#62584f]">Lemon cake, citrus curd, and floral cream.</span></span>
        </a>
        <a class="flex items-center gap-5 rounded-[2rem] bg-[#f2c8bd] p-6" href="/order/cake/finish/">
          <span class="grid size-20 shrink-0 place-items-center rounded-full bg-[#bd4828] text-4xl text-white" aria-hidden="true">♡</span><span><strong class="text-xl">Carrot & brown butter</strong><span class="mt-2 block leading-6 text-[#62584f]">Spiced cake with tangy brown-butter frosting.</span></span>
        </a>
      </div>
    </section>
  </main>
{% endblock %}
