{% layout 'base' %}

{% block content %}
  <main class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
    {% render 'order-progress', order_steps: order_steps, page: page %}
    <section class="mt-12 grid gap-10 lg:grid-cols-[1fr_0.8fr]">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#b14f31]">Step 3 of 5 · Finish</p>
        <h1 class="mt-3 text-5xl font-bold tracking-[-0.04em] sm:text-6xl">{{ page.title }}</h1>
        <p class="mt-5 text-lg leading-8 text-[#62584f]">{{ page.description }}</p>
        <div class="mt-9 space-y-3">
          <a class="flex items-center justify-between rounded-2xl border-2 border-[#bd4828] p-5 font-bold" href="/order/cake/pickup/"><span>Garden flowers</span><span class="text-[#b14f31]">Included</span></a>
          <a class="flex items-center justify-between rounded-2xl bg-[#f4e6d2] p-5 font-bold" href="/order/cake/pickup/"><span>Chocolate message</span><span>+$6</span></a>
          <a class="flex items-center justify-between rounded-2xl bg-[#dbe5cb] p-5 font-bold" href="/order/cake/pickup/"><span>Extra candles</span><span>+$4</span></a>
        </div>
      </div>
      <div class="grid min-h-96 place-items-center rounded-[3rem] bg-[#f2c8bd] p-10">
        <div class="grid aspect-square w-full place-items-center rounded-full bg-[#fffaf1] text-7xl shadow-[0_24px_0_#bd4828]" aria-label="Cake preview">✿</div>
      </div>
    </section>
  </main>
{% endblock %}
