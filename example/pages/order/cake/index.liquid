{% layout 'base' %}

{% block content %}
  <main class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
    {% render 'order-progress', order_steps: order_steps, page: page %}
    <section class="mt-12">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#b14f31]">Step 1 of 5 · Size</p>
      <h1 class="mt-3 text-5xl font-bold tracking-[-0.04em] sm:text-6xl">{{ page.title }}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-[#62584f]">{{ page.description }}</p>
      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        <a class="rounded-[2rem] border-2 border-transparent bg-[#f4e6d2] p-6 hover:border-[#bd4828]" href="/order/cake/flavor/">
          <span class="text-4xl" aria-hidden="true">●</span><h2 class="mt-5 text-xl font-bold">Little party</h2><p class="mt-2 text-[#62584f]">8 servings · $48</p>
        </a>
        <a class="rounded-[2rem] border-2 border-[#bd4828] bg-[#fffaf1] p-6" href="/order/cake/flavor/">
          <span class="text-5xl" aria-hidden="true">●</span><h2 class="mt-4 text-xl font-bold">Full table</h2><p class="mt-2 text-[#62584f]">16 servings · $72</p><p class="mt-5 text-sm font-bold text-[#b14f31]">Most popular</p>
        </a>
        <a class="rounded-[2rem] border-2 border-transparent bg-[#dbe5cb] p-6 hover:border-[#bd4828]" href="/order/cake/flavor/">
          <span class="text-6xl" aria-hidden="true">●</span><h2 class="mt-3 text-xl font-bold">Big gathering</h2><p class="mt-2 text-[#62584f]">32 servings · $118</p>
        </a>
      </div>
    </section>
  </main>
{% endblock %}
