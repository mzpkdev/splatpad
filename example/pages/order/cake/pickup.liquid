{% layout 'base' %}

{% block content %}
  <main class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
    {% render 'order-progress', order_steps: order_steps, page: page %}
    <section class="mt-12">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#b14f31]">Step 4 of 5 · Pickup</p>
      <h1 class="mt-3 text-5xl font-bold tracking-[-0.04em] sm:text-6xl">{{ page.title }}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-[#62584f]">{{ page.description }}</p>
      <form class="mt-10 grid gap-8 lg:grid-cols-2" action="/order/cake/review/" method="get">
        <fieldset>
          <legend class="text-2xl font-bold">Pickup date</legend>
          <div class="mt-6 grid grid-cols-2 gap-3">
            <label class="flex cursor-pointer items-center gap-3 rounded-2xl bg-[#f4e6d2] p-5">
              <input class="h-5 w-5 accent-[#bd4828]" type="radio" name="pickup-date" value="18" required>
              <span class="text-center"><span class="block text-sm font-bold uppercase text-[#74685e]">Thursday</span><strong class="mt-2 block text-2xl">18</strong></span>
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-2xl border-2 border-[#bd4828] p-5">
              <input class="h-5 w-5 accent-[#bd4828]" type="radio" name="pickup-date" value="19">
              <span class="text-center"><span class="block text-sm font-bold uppercase text-[#b14f31]">Friday</span><strong class="mt-2 block text-2xl">19</strong></span>
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-2xl bg-[#dbe5cb] p-5">
              <input class="h-5 w-5 accent-[#bd4828]" type="radio" name="pickup-date" value="20">
              <span class="text-center"><span class="block text-sm font-bold uppercase text-[#74685e]">Saturday</span><strong class="mt-2 block text-2xl">20</strong></span>
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-2xl bg-[#f2c8bd] p-5">
              <input class="h-5 w-5 accent-[#bd4828]" type="radio" name="pickup-date" value="21">
              <span class="text-center"><span class="block text-sm font-bold uppercase text-[#74685e]">Sunday</span><strong class="mt-2 block text-2xl">21</strong></span>
            </label>
          </div>
        </fieldset>
        <fieldset>
          <legend class="text-2xl font-bold">Pickup window</legend>
          <div class="mt-6 grid gap-3 rounded-[2rem] bg-[#302b27] p-7 text-white">
            <label class="flex cursor-pointer items-center gap-3 rounded-full bg-white px-5 py-3 font-bold text-[#302b27]">
              <input class="h-5 w-5 accent-[#bd4828]" type="radio" name="pickup-window" value="9:00–11:00" required>
              <span>9:00–11:00</span>
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-full border border-white/30 px-5 py-3 font-bold">
              <input class="h-5 w-5 accent-[#f2c8bd]" type="radio" name="pickup-window" value="11:00–1:00">
              <span>11:00–1:00</span>
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-full border border-white/30 px-5 py-3 font-bold">
              <input class="h-5 w-5 accent-[#f2c8bd]" type="radio" name="pickup-window" value="1:00–3:00">
              <span>1:00–3:00</span>
            </label>
          </div>
        </fieldset>
        <button class="rounded-full bg-[#bd4828] px-7 py-4 text-lg font-bold text-white lg:col-span-2" type="submit">Review your order</button>
      </form>
    </section>
  </main>
{% endblock %}
