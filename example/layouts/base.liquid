<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ page.description | escape }}">
    <title>{{ page.title | escape }} | {{ site.name | escape }}</title>
    <link rel="stylesheet" href="/__uno.css">
  </head>
  <body class="min-h-screen bg-[#fffaf1] text-[#302b27] antialiased" data-page="{{ route }}">
    <header class="border-b border-[#302b27]/10 bg-[#fffaf1]" data-frame="Site header">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-5 px-5 py-5 sm:px-8">
        <a class="flex items-center gap-3 text-lg font-bold tracking-tight" href="/">
          <span class="grid size-9 place-items-center rounded-full bg-[#bd4828] text-xl text-white" aria-hidden="true">✿</span>
          {{ site.name }}
        </a>
        <nav aria-label="Primary navigation" data-frame="Primary navigation">
          <ul class="flex flex-wrap items-center justify-end gap-2 text-sm font-semibold sm:gap-4">
            {% for link in navigation %}
              {% assign is_current = false %}
              {% if link.href == route %}
                {% assign is_current = true %}
              {% elsif link.href != '/' and route contains link.href %}
                {% assign is_current = true %}
              {% endif %}
              <li>
                {% component "nav-link", href: link.href, current: is_current %}
                  {{ link.label }}
                {% endcomponent %}
              </li>
            {% endfor %}
          </ul>
        </nav>
      </div>
    </header>

    {% block content %}{% endblock %}

    <footer class="border-t border-[#302b27]/10" data-frame="Site footer">
      <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-3 px-5 py-8 text-sm text-[#74685e] sm:px-8">
        <p>Good bread. Kind mornings. Made on Alder Street.</p>
        <p>{{ site.hours_short }}</p>
      </div>
    </footer>
  </body>
</html>
