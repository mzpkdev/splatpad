{
  "name": "splatpad",
  "version": "0.0.0",
  "private": true,
  "description": "Build and serve LiquidJS sites with Tailwind CSS utility syntax.",
  "bin": {
    "splatpad": "bin/splatpad"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "obuild",
    "build:example": "npm run build && node bin/splatpad build example",
    "dev": "npm run build && node bin/splatpad serve example",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "preview:example": "vite preview example --config e2e/vite-preview.config.ts --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@unocss/preset-wind4": "^66.7.5",
    "@xyflow/react": "^12.11.2",
    "cmdore": "^0.4.1",
    "liquidjs": "^10.28.0",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "unocss": "^66.7.5",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "obuild": "^0.4.38",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
