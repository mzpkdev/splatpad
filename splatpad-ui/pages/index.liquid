{% layout 'base' %}

{% block content %}
  <main class="flex h-screen flex-col overflow-hidden bg-[#101012] text-[11px] text-zinc-200">
    <header class="flex h-12 shrink-0 items-center border-b border-zinc-700/80 bg-[#18181b] text-white shadow-[0_1px_8px_rgba(0,0,0,0.3)]" aria-label="Editor header">
      <div class="flex h-full w-12 items-center justify-center bg-violet-600">
        <img class="h-5 w-5" src="/splatpad.svg" alt="Splatpad">
      </div>
      <div class="flex min-w-0 items-center gap-2 px-3 text-[12px] font-medium">
        <span class="text-zinc-400">example</span>
        <svg class="h-3 w-3 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        <span>Components</span>
        <span class="rounded-full bg-violet-500/15 px-2 py-0.5 font-mono text-[9px] font-semibold text-violet-300">10</span>
      </div>
      <div class="ml-auto flex h-full items-center gap-2 px-3">
        <button class="grid h-7 w-7 place-items-center rounded-md text-zinc-400 hover:bg-zinc-800 hover:text-zinc-100" title="Search">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </button>
        <span class="h-4 w-px bg-zinc-700"></span>
        <span class="rounded-md bg-violet-600 px-3 py-1.5 text-[11px] font-semibold shadow-sm">Share</span>
      </div>
    </header>

    <div class="flex min-h-0 flex-1">
      <aside class="flex w-12 shrink-0 flex-col items-center border-r border-zinc-700/80 bg-[#18181b] py-2" aria-label="Design tools">
        <span class="grid h-9 w-9 place-items-center rounded-md bg-violet-600 text-white" title="Move">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.04 4.69a.5.5 0 0 1 .65-.65l16 6.5a.5.5 0 0 1-.06.95l-6.13 1.58A2 2 0 0 0 13.06 14.5l-1.58 6.13a.5.5 0 0 1-.95.06z"/></svg>
        </span>
        <span class="mt-1 grid h-9 w-9 place-items-center rounded-md text-zinc-500" title="Inspect">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 3a2 2 0 0 0-2 2v4m16-6a2 2 0 0 1 2 2v4M5 21a2 2 0 0 1-2-2v-4m16 6a2 2 0 0 0 2-2v-4"/><circle cx="12" cy="12" r="3"/></svg>
        </span>
        <div class="mt-auto">
          <span class="grid h-9 w-9 place-items-center rounded-md text-zinc-500" title="Help">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 1 1 5.8 1c0 2-3 3-3 3M12 17h.01"/></svg>
          </span>
        </div>
      </aside>

      <aside class="hidden w-56 shrink-0 flex-col border-r border-zinc-700/80 bg-[#1b1b1e] md:flex" aria-label="Project navigator">
        <div class="grid h-10 shrink-0 grid-cols-2 border-b border-zinc-700/80 px-2 pt-1">
          <button class="border-b-2 border-transparent text-zinc-500">Pages</button>
          <button class="border-b-2 border-violet-500 font-semibold text-zinc-100">Components</button>
        </div>
        <div class="p-2">
          <label class="flex h-8 items-center gap-2 rounded-md border border-zinc-700 bg-[#151517] px-2 text-zinc-500">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <span>Find components</span>
            <span class="ml-auto rounded border border-zinc-700 px-1 font-mono text-[9px]">⌘K</span>
          </label>
        </div>
        <nav class="min-h-0 flex-1 overflow-y-auto px-2 pb-3" aria-label="Component groups">
          <div class="mb-1 flex h-7 items-center gap-1.5 px-1 text-[10px] font-semibold uppercase tracking-[0.08em] text-zinc-500">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            Actions
            <span class="ml-auto font-mono font-normal">3</span>
          </div>
          <button class="flex h-8 w-full items-center gap-2 rounded-md bg-violet-500/15 px-2 font-medium text-violet-200" aria-current="true">
            <span class="grid h-4 w-4 place-items-center rounded border border-violet-400/50 bg-violet-400/15 text-[9px]">◇</span> Button
            <span class="ml-auto h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
          </button>
          <button class="flex h-8 w-full items-center gap-2 rounded-md px-2 text-zinc-400"><span class="grid h-4 w-4 place-items-center rounded border border-zinc-600 text-[9px]">◇</span> Icon button</button>
          <button class="flex h-8 w-full items-center gap-2 rounded-md px-2 text-zinc-400"><span class="grid h-4 w-4 place-items-center rounded border border-zinc-600 text-[9px]">◇</span> Link</button>

          <div class="mb-1 mt-3 flex h-7 items-center gap-1.5 px-1 text-[10px] font-semibold uppercase tracking-[0.08em] text-zinc-500">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            Forms
            <span class="ml-auto font-mono font-normal">3</span>
          </div>
          <button class="flex h-8 w-full items-center gap-2 rounded-md px-2 text-zinc-400"><span class="grid h-4 w-4 place-items-center rounded border border-zinc-600 text-[9px]">◇</span> Input</button>
          <button class="flex h-8 w-full items-center gap-2 rounded-md px-2 text-zinc-400"><span class="grid h-4 w-4 place-items-center rounded border border-zinc-600 text-[9px]">◇</span> Select</button>
          <button class="flex h-8 w-full items-center gap-2 rounded-md px-2 text-zinc-400"><span class="grid h-4 w-4 place-items-center rounded border border-zinc-600 text-[9px]">◇</span> Checkbox</button>

          <div class="mb-1 mt-3 flex h-7 items-center gap-1.5 px-1 text-[10px] font-semibold uppercase tracking-[0.08em] text-zinc-500">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            Display
            <span class="ml-auto font-mono font-normal">4</span>
          </div>
          <button class="flex h-8 w-full items-center gap-2 rounded-md px-2 text-zinc-400"><span class="grid h-4 w-4 place-items-center rounded border border-zinc-600 text-[9px]">◇</span> Card</button>
          <button class="flex h-8 w-full items-center gap-2 rounded-md px-2 text-zinc-400"><span class="grid h-4 w-4 place-items-center rounded border border-zinc-600 text-[9px]">◇</span> Badge</button>
          <button class="flex h-8 w-full items-center gap-2 rounded-md px-2 text-zinc-400"><span class="grid h-4 w-4 place-items-center rounded border border-zinc-600 text-[9px]">◇</span> Avatar</button>
          <button class="flex h-8 w-full items-center gap-2 rounded-md px-2 text-zinc-400"><span class="grid h-4 w-4 place-items-center rounded border border-zinc-600 text-[9px]">◇</span> Toast</button>
        </nav>
        <div class="border-t border-zinc-700/80 p-3 text-[10px] text-zinc-500">
          <div class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span> 10 components discovered</div>
          <p class="mt-1 pl-3.5 font-mono text-[9px] text-zinc-400">components/**/*.liquid</p>
        </div>
      </aside>

      <section class="relative min-w-0 flex-1 overflow-hidden bg-[#121214]" aria-label="Component gallery">
        <div class="flex h-11 items-center border-b border-zinc-700/70 bg-[#171719] px-4">
          <div>
            <h1 class="text-[12px] font-semibold text-zinc-100">Component gallery</h1>
            <p class="text-[9px] text-zinc-500">Live specimens from your Liquid files</p>
          </div>
          <div class="ml-auto flex items-center gap-2">
            <div class="flex rounded-md border border-zinc-700 bg-[#111113] p-0.5">
              <button class="grid h-6 w-7 place-items-center rounded bg-zinc-700 text-zinc-100" title="Gallery view">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
              </button>
              <button class="grid h-6 w-7 place-items-center rounded text-zinc-500" title="List view">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
              </button>
            </div>
            <button class="flex h-7 items-center gap-1.5 rounded-md border border-zinc-700 bg-[#111113] px-2 text-zinc-400" title="Background sampled from the root page">
              <span class="h-3 w-3 rounded-sm border border-zinc-500 bg-[#f7f8fa]"></span> From /
              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          </div>
        </div>

        <div class="h-[calc(100%-2.75rem)] overflow-auto bg-[#f7f8fa] [background-image:radial-gradient(rgba(100,116,139,0.18)_1px,transparent_1px)] [background-position:0_0] [background-size:20px_20px]">
          <div class="mx-auto max-w-[1120px] p-8 lg:p-10">
            <section aria-labelledby="actions-title">
              <div class="mb-5 flex items-end justify-between">
                <div><h2 id="actions-title" class="text-[13px] font-semibold text-slate-900">Actions</h2><p class="mt-0.5 text-[10px] text-slate-500">3 components · 8 specimens</p></div>
                <span class="font-mono text-[9px] text-slate-500">components/actions</span>
              </div>

              <article class="relative min-h-48 border border-dashed border-violet-400/70 px-7 pb-7 pt-12" aria-label="Button component">
                <div class="absolute left-3 top-3 flex items-center gap-2">
                  <h3 class="font-semibold text-violet-700">Button</h3>
                  <span class="font-mono text-[8px] text-slate-600">4 variants</span>
                </div>
                <span class="absolute right-3 top-3 font-mono text-[8px] text-slate-600">actions/button.liquid</span>
                <div class="grid min-h-28 items-center gap-8 sm:grid-cols-2 xl:grid-cols-4">
                  <div class="text-center">
                    <p class="mb-4 font-mono text-[8px] text-slate-600">Primary</p>
                    <button class="rounded-lg bg-violet-600 px-4 py-2 text-[10px] font-semibold text-white shadow-sm">Create project</button>
                  </div>
                  <div class="text-center">
                    <p class="mb-4 font-mono text-[8px] text-slate-600">Secondary</p>
                    <button class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-[10px] font-semibold text-slate-700 shadow-sm">View details</button>
                  </div>
                  <div class="text-center">
                    <p class="mb-4 font-mono text-[8px] text-slate-600">Ghost</p>
                    <button class="rounded-lg px-4 py-2 text-[10px] font-semibold text-slate-700 hover:bg-slate-200/60">Cancel</button>
                  </div>
                  <div class="text-center">
                    <p class="mb-4 font-mono text-[8px] text-slate-600">Danger</p>
                    <button class="rounded-lg bg-rose-600 px-4 py-2 text-[10px] font-semibold text-white shadow-sm">Delete project</button>
                  </div>
                </div>
              </article>

              <div class="mt-7 grid gap-7 lg:grid-cols-[minmax(0,1.35fr)_minmax(240px,0.65fr)]">
                <article class="relative min-h-36 border border-dashed border-slate-300 p-8 pt-11">
                  <h3 class="absolute left-3 top-3 font-semibold text-slate-800">Icon button <span class="ml-1 font-mono text-[8px] font-normal text-slate-500">3 variants</span></h3>
                  <div class="flex min-h-16 items-center justify-center gap-5">
                    <button class="grid h-9 w-9 place-items-center rounded-lg bg-violet-600 text-white"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></button>
                    <button class="grid h-9 w-9 place-items-center rounded-lg border border-slate-300 bg-white text-slate-600"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2m3 0-1 15H6L5 6m5 4v7m4-7v7"/></svg></button>
                    <button class="grid h-9 w-9 place-items-center rounded-lg text-slate-500"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg></button>
                  </div>
                </article>
                <article class="relative min-h-36 border border-dashed border-slate-300 p-8 pt-11">
                  <h3 class="absolute left-3 top-3 font-semibold text-slate-800">Link</h3>
                  <div class="flex min-h-16 flex-col items-center justify-center gap-3 text-[10px] font-medium">
                    <a class="text-violet-400 underline underline-offset-2">Read documentation</a>
                    <a class="flex items-center gap-1 text-slate-700">View project <span>→</span></a>
                  </div>
                </article>
              </div>
            </section>

            <section class="mt-10" aria-labelledby="forms-title">
              <div class="mb-5"><h2 id="forms-title" class="text-[13px] font-semibold text-slate-900">Forms</h2><p class="mt-0.5 text-[10px] text-slate-500">3 components · 5 specimens</p></div>
              <div class="grid items-start gap-7 md:grid-cols-2 xl:grid-cols-3">
                <article class="relative min-h-48 border border-dashed border-slate-300 px-6 pb-6 pt-12">
                  <h3 class="absolute left-3 top-3 font-semibold text-slate-800">Input</h3>
                  <span class="absolute right-3 top-3 font-mono text-[8px] text-slate-500">480px</span>
                  <div class="mt-4 text-slate-700">
                    <label class="text-[9px] font-semibold">Email address</label>
                    <div class="mt-1.5 rounded-lg border border-violet-500 bg-white px-3 py-2.5 text-[10px] shadow-[0_0_0_3px_rgba(139,92,246,0.12)]">maya@northstar.co</div>
                    <p class="mt-1.5 text-[8px] text-slate-500">We’ll never share your email.</p>
                  </div>
                </article>
                <article class="relative min-h-48 border border-dashed border-slate-300 px-6 pb-6 pt-12">
                  <h3 class="absolute left-3 top-3 font-semibold text-slate-800">Select</h3>
                  <span class="absolute right-3 top-3 font-mono text-[8px] text-slate-500">320px</span>
                  <div class="mt-4 text-slate-700"><label class="text-[9px] font-semibold">Workspace</label><div class="mt-1.5 flex rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-[10px]"><span>Northstar</span><span class="ml-auto text-slate-500">⌄</span></div></div>
                </article>
                <article class="relative min-h-36 border border-dashed border-slate-300 px-6 pb-6 pt-12 md:col-span-2 xl:col-span-1">
                  <h3 class="absolute left-3 top-3 font-semibold text-slate-800">Checkbox</h3>
                  <span class="absolute right-3 top-3 font-mono text-[8px] text-slate-500">2 states</span>
                  <div class="mt-2 flex flex-col gap-3 text-slate-700">
                    <label class="flex items-center gap-2.5"><span class="grid h-4 w-4 place-items-center rounded bg-violet-500 text-[9px] text-white">✓</span><span>Send weekly summary</span></label>
                    <label class="flex items-center gap-2.5"><span class="h-4 w-4 rounded border border-slate-300 bg-white"></span><span class="text-slate-500">Product updates</span></label>
                  </div>
                </article>
              </div>
            </section>
          </div>
        </div>
      </section>

      <aside class="hidden w-60 shrink-0 flex-col border-l border-zinc-700/80 bg-[#1b1b1e] xl:flex" aria-label="Component inspector">
        <div class="flex h-11 items-center border-b border-zinc-700/80 px-3"><h2 class="font-semibold">Button</h2><span class="ml-auto rounded bg-violet-500/15 px-1.5 py-0.5 text-[8px] font-semibold text-violet-300">SELECTED</span></div>
        <div class="min-h-0 flex-1 overflow-y-auto">
          <section class="border-b border-zinc-700/80 p-3">
            <h3 class="text-[9px] font-semibold uppercase tracking-[0.08em] text-zinc-500">Source</h3>
            <div class="mt-2 rounded-md border border-zinc-700 bg-[#141416] p-2.5 font-mono text-[9px] leading-4 text-zinc-400"><span class="text-zinc-400">components/</span><br>actions/button.liquid</div>
            <div class="mt-2 flex items-center gap-2 text-[9px] text-emerald-300"><span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span> Preview ready</div>
          </section>
          <section class="border-b border-zinc-700/80 p-3">
            <div class="flex items-center"><h3 class="text-[9px] font-semibold uppercase tracking-[0.08em] text-zinc-500">Specimens</h3><button class="ml-auto text-[9px] text-violet-300">Open file ↗</button></div>
            <div class="mt-2 space-y-1">
              <button class="flex h-8 w-full items-center rounded-md bg-violet-500/15 px-2 text-violet-200"><span>Primary</span><span class="ml-auto font-mono text-[8px]">default</span></button>
              <button class="flex h-8 w-full items-center rounded-md px-2 text-zinc-400"><span>Secondary</span><span class="ml-auto font-mono text-[8px]">outline</span></button>
              <button class="flex h-8 w-full items-center rounded-md px-2 text-zinc-400"><span>Ghost</span><span class="ml-auto font-mono text-[8px]">ghost</span></button>
              <button class="flex h-8 w-full items-center rounded-md px-2 text-zinc-400"><span>Danger</span><span class="ml-auto font-mono text-[8px]">danger</span></button>
            </div>
          </section>
          <section class="border-b border-zinc-700/80 p-3">
            <h3 class="text-[9px] font-semibold uppercase tracking-[0.08em] text-zinc-500">Preview surface</h3>
            <div class="mt-2 grid grid-cols-4 gap-1.5">
              <button class="aspect-square rounded-md border-2 border-violet-500 bg-white" title="Light"></button>
              <button class="aspect-square rounded-md border border-zinc-700 bg-[#242429]" title="Dark"></button>
              <button class="aspect-square rounded-md border border-zinc-700 [background-image:linear-gradient(45deg,#444_25%,transparent_25%),linear-gradient(-45deg,#444_25%,transparent_25%),linear-gradient(45deg,transparent_75%,#444_75%),linear-gradient(-45deg,transparent_75%,#444_75%)] [background-position:0_0,0_5px,5px_-5px,-5px_0px] [background-size:10px_10px]" title="Transparent"></button>
              <button class="grid aspect-square place-items-center rounded-md border border-zinc-700 text-zinc-500" title="Custom">+</button>
            </div>
          </section>
          <section class="p-3">
            <h3 class="text-[9px] font-semibold uppercase tracking-[0.08em] text-zinc-500">Preview width</h3>
            <div class="mt-2 flex items-center gap-2"><input class="min-w-0 flex-1 accent-violet-500" type="range" min="240" max="768" value="480"><span class="w-12 rounded-md border border-zinc-700 bg-[#141416] px-1.5 py-1 text-center font-mono text-[9px]">480</span></div>
            <p class="mt-2 text-[9px] leading-4 text-zinc-500">Double-click a specimen to open it in a focused workbench.</p>
          </section>
        </div>
      </aside>
    </div>
  </main>
{% endblock %}
