                      <svg class="h-3.5 w-3.5 shrink-0 text-zinc-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="6" height="5" rx="1"/><rect x="11" y="11" width="6" height="5" rx="1"/><path d="M6 9v4h5"/></svg>
                      <span class="min-w-0 truncate">Dashboard content</span>
                    </div>
                    <ul class="ml-2.5 border-l border-zinc-700 pl-1.5" role="list">
