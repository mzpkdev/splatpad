    <header class="flex h-12 shrink-0 items-center border-b border-zinc-700 bg-[#18181b] text-white shadow-[0_1px_8px_rgba(0,0,0,0.35)]" aria-label="Editor header">
      <div class="flex h-full w-12 items-center justify-center bg-[#7c3aed]">
        <img class="h-5 w-5" src="/splatpad.svg" alt="Splatpad">
      </div>

      <div class="min-w-0 px-3 text-[12px] font-medium text-zinc-300" aria-label="Current route">
        <span class="text-zinc-400">splatpad-ui</span>
        <span class="ml-2 rounded bg-violet-500/15 px-1.5 py-0.5 font-mono text-[10px] text-violet-300">/</span>
      </div>

      <div class="ml-auto flex h-full items-center gap-2 px-3">
        <div class="hidden items-center -space-x-1.5 sm:flex" aria-label="Collaborators">
          <span class="grid h-6 w-6 place-items-center rounded-full border-2 border-[#18181b] bg-amber-300 text-[9px] font-bold text-amber-900">AK</span>
          <span class="grid h-6 w-6 place-items-center rounded-full border-2 border-[#18181b] bg-sky-300 text-[9px] font-bold text-sky-900">MJ</span>
        </div>
        <span class="rounded-md bg-[#7c3aed] px-3 py-1.5 text-[11px] font-semibold shadow-sm">Share</span>
        <span class="grid h-7 w-7 place-items-center rounded" title="Present" aria-hidden="true">
          <svg class="lucide lucide-play h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/></svg>
        </span>
      </div>
    </header>

    <div class="flex min-h-0 flex-1">
